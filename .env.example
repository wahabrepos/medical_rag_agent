# Copy to .env and fill in. Never commit .env.

# Runtime
APP_ENV=local            # local | dev | prod
LOG_LEVEL=INFO

# LLM providers: primary Mistral, fallback Groq (LiteLLM model names)
MISTRAL_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=mistral/mistral-small-latest
LLM_FALLBACK_MODEL=groq/openai/gpt-oss-120b

# Hugging Face (model downloads)
HF_TOKEN=

# Storage
DATABASE_URL=postgresql+psycopg://medrag:medrag@localhost:5432/medrag
REDIS_URL=redis://localhost:6379/0

# Inference service
# INFERENCE_THREADS=4     # unset = ONNX Runtime default

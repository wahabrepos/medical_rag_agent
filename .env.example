# Copy to .env and fill in. Never commit .env.

# Runtime
APP_ENV=local            # local | dev | prod
LOG_LEVEL=INFO

# LLM providers (LiteLLM model names). Mistral-small needs a paid plan, so Groq is primary.
MISTRAL_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=groq/openai/gpt-oss-120b
LLM_FALLBACK_MODEL=mistral/mistral-small-2603
LLM_REQUESTS_PER_MINUTE=30
LLM_TOKENS_PER_MINUTE=8000

# Hugging Face (model downloads)
HF_TOKEN=

# Storage
DATABASE_URL=postgresql+psycopg://medrag:medrag@localhost:5432/medrag
REDIS_URL=redis://localhost:6379/0

# Inference service
# INFERENCE_THREADS=4     # unset = ONNX Runtime default

# Public API
# API_KEYS=key-one,key-two   # bearer keys; unset = open API only when APP_ENV=local
API_REQUESTS_PER_MINUTE=20
ANSWER_POLICY=evidence_gated   # or uncertain_yes_no, show_all
EVIDENCE_QUOTES=true           # claims must quote a retrieved passage word for word
# NLI_URL=http://localhost:18001   # optional remote NLI (see deploy/vast)
# Claim verifier: deberta-nli (research-work parity, default) or minicheck (grounding;
# export the ONNX with services/inference/scripts/export_minicheck.py first).
# VERIFIER=minicheck
# VERIFIER_ONNX_PATH=data/models/minicheck-roberta-large.onnx
# Research evaluation only (no licence for products): MedRAG textbooks as background
# knowledge, built with workers/ingest/gpu/export_textbooks.py + embed_chunks.py.
# KNOWLEDGE_DIR=data/knowledge/textbooks
LLM_BUDGET=3.0

# Live PubMed search (optional)
LIVE_PUBMED=false
# NCBI_EMAIL=you@example.org   # NCBI asks callers to identify themselves
# NCBI_API_KEY=                # raises the limit from 3 to 10 requests per second

# Copy to .env and fill in. Never commit .env.

# Runtime
APP_ENV=local            # local | dev | prod
LOG_LEVEL=INFO

# LLM providers (LiteLLM model names). Mistral-small needs a paid plan, so Groq is primary.
MISTRAL_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=groq/openai/gpt-oss-120b
LLM_FALLBACK_MODEL=mistral/mistral-small-2603
LLM_REQUESTS_PER_MINUTE=30
LLM_TOKENS_PER_MINUTE=8000

# Hugging Face (model downloads)
HF_TOKEN=

# Storage
DATABASE_URL=postgresql+psycopg://medrag:medrag@localhost:5432/medrag
REDIS_URL=redis://localhost:6379/0

# Inference service
# INFERENCE_THREADS=4     # unset = ONNX Runtime default
